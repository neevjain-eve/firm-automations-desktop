# Database (Supabase Postgres connection string, or any Postgres instance)
DATABASE_URL="postgresql://user:password@host:5432/firm_app"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Restrict sign-in to your firm's Google Workspace domain
ALLOWED_EMAIL_DOMAIN="yourfirm.com"

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=""

# --- Security-critical (the app and its legacy modules will not work safely without these) ---
# Signs the legacy to-do/status session tokens. REQUIRED, at least 32 random characters.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=""

# Protects /api/admin/create-user and /api/seed. Without it both endpoints are disabled.
ADMIN_SETUP_SECRET=""

# Self-sign-up at /signup requires this invite code (give it only to firm staff).
# If left empty, self-sign-up is disabled and an admin must create accounts.
SIGNUP_INVITE_CODE=""
